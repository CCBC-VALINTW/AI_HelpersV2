@implements IDisposable
@inherits LayoutComponentBase
@inject Services.ICurrentUserService CurrentUser
@inject Services.ISpendStatusService SpendStatus
@inject Services.IAccessLogService AccessLog
@inject Services.IFeedbackPromptService FeedbackPrompt

@* @key gives Blazor stable identity for these two - without it, a re-render of this layout
   (e.g. SpendStatus.Changed firing) can shift positional diffing enough to tear down and
   recreate a <dialog> element, silently discarding its native showModal()-opened state (Blazor's
   virtual DOM has no idea a dialog was imperatively opened via JS - that's real browser state
   outside its tracking). Real bug hit exactly this way when FeedbackModal was added as a new
   sibling here. *@
<BetaNoticeModal @key="BetaNoticeModalKey" />
<FeedbackModal @key="FeedbackModalKey" @ref="_feedbackModal" />

<div class="page">
    <input type="checkbox" id="sidebarCollapse" class="sidebar-collapse-checkbox"
           onchange="localStorage.setItem('sidebarCollapsed', this.checked)" />
    <script>
        // Restore the collapsed/expanded state on full page load - in-app navigation between
        // pages keeps this same DOM node (Blazor Server diffs, doesn't recreate the layout), so
        // this only needs to run once per real page load, not per navigation.
        document.getElementById('sidebarCollapse').checked = localStorage.getItem('sidebarCollapsed') === 'true';
    </script>
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (SpendStatus.Loaded)
            {
                <span class="spend-status @SpendStatusCssClass">
                    Used £@SpendStatus.CurrentSpend.ToString("0.00") of your £@SpendStatus.CurrentCap.ToString("0.00") allowance this month
                </span>
            }
            @if (_displayName is not null)
            {
                <span class="signed-in-as">Signed in as @_displayName</span>
                <a href="MicrosoftIdentity/Account/SignOut">Sign out</a>
            }
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string BetaNoticeModalKey = "beta-notice-modal";
    private const string FeedbackModalKey = "feedback-modal";

    private string? _displayName;
    private FeedbackModal? _feedbackModal;

    private string SpendStatusCssClass => SpendStatus.CurrentSpend >= SpendStatus.CurrentCap
        ? "spend-status-over"
        : SpendStatus.CurrentSpend >= SpendStatus.CurrentCap * 0.8m
            ? "spend-status-warn"
            : "";

    protected override async Task OnInitializedAsync()
    {
        SpendStatus.Changed += OnSpendChanged;
        FeedbackPrompt.ShowHandler = HandleFeedbackShowAsync;
        try
        {
            // Can be briefly reached with no signed-in user while AuthorizeRouteView is
            // mid-redirecting an anonymous visitor to sign-in - leave the name/spend blank rather
            // than crash the layout for that transient moment.
            _displayName = await CurrentUser.GetDisplayNameAsync();
            var email = await CurrentUser.GetEmailAsync();
            await SpendStatus.RefreshAsync(email);
            // Once per real page load, same as SpendStatus above - not per in-app navigation.
            // Silent by design (AccessLogService swallows its own failures) - never worth breaking
            // a page load over.
            await AccessLog.LogAsync(email);
        }
        catch (InvalidOperationException)
        {
            _displayName = null;
        }
    }

    private void OnSpendChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Bridges NavMenu's "Feedback" link to this layout's own FeedbackModal instance -
    /// see IFeedbackPromptService's own doc comment for why this is an awaitable delegate rather
    /// than a plain event.</summary>
    private async Task HandleFeedbackShowAsync(string? helperName, int? helperDefinitionId)
    {
        if (_feedbackModal is null) return;

        string email;
        try
        {
            email = await CurrentUser.GetEmailAsync();
        }
        catch (InvalidOperationException)
        {
            return; // No signed-in user to attribute feedback to - nothing to show.
        }

        await _feedbackModal.ShowAsync(helperName, helperDefinitionId, email);
    }

    public void Dispose()
    {
        SpendStatus.Changed -= OnSpendChanged;
        if (FeedbackPrompt.ShowHandler == HandleFeedbackShowAsync) FeedbackPrompt.ShowHandler = null;
    }
}
