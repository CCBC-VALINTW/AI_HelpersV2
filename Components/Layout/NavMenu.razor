<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid d-flex align-items-center justify-content-between px-0">
        <a class="navbar-brand" href=""><span class="nav-link-text">AI Helpers</span></a>
        <label for="sidebarCollapse" class="sidebar-collapse-btn" title="Collapse menu" role="button">
            <span class="bi bi-collapse-nav-menu" aria-hidden="true"></span>
        </label>
    </div>
    <div class="built-by-badge-row nav-link-text">
        <img class="built-by-badge-sidebar" src="badges/built-by-conwy.svg" alt="Built by Conwy / Wedi'i greu gan Conwy" />
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    @if (_isDevelopment)
    {
        <div class="dev-environment-notice">
            <p class="mb-1"><strong>Development environment</strong></p>
            <p class="mb-1">This is the active development environment and may be unstable.</p>
            <a href="https://aihelpers.corp.conwy.gov.uk">Go to the production site</a>
        </div>
    }
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> <span class="nav-link-text">Home</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="helpers" title="Helpers">
                <span class="bi bi-grid-fill-nav-menu" aria-hidden="true"></span> <span class="nav-link-text">Helpers</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="personality" title="Personality Profile">
                <span class="bi bi-personality-nav-menu" aria-hidden="true"></span> <span class="nav-link-text">Personality</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="helpers/editor" title="Helper Editor">
                <span class="bi bi-editor-nav-menu" aria-hidden="true"></span> <span class="nav-link-text">Helper Editor</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="documents" title="Documents">
                <span class="bi bi-documents-nav-menu" aria-hidden="true"></span> <span class="nav-link-text">Documents</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="recent-runs" title="Recent Runs">
                <span class="bi bi-recent-runs-nav-menu" aria-hidden="true"></span> <span class="nav-link-text">Recent Runs</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <button type="button" class="nav-link feedback-nav-button @(_shouldPulse ? "feedback-pulse" : "")"
                    title="Feedback" @onclick="RequestFeedback">
                <span class="bi bi-feedback-nav-menu" aria-hidden="true"></span> <span class="nav-link-text">Feedback</span>
            </button>
        </div>

        @if (_isAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin" title="Admin">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> <span class="nav-link-text">Admin</span>
                </NavLink>
            </div>
        }
    </nav>
</div>

@implements IDisposable
@code {
    [Inject] private Services.ICurrentUserService CurrentUser { get; set; } = default!;
    [Inject] private Services.IFeedbackPromptService FeedbackPrompt { get; set; } = default!;
    [Inject] private IWebHostEnvironment Env { get; set; } = default!;

    private bool _isAdmin;
    private bool _shouldPulse;

    // Same real-hosting-environment read as MainLayout's own IsDevelopment - kept as an
    // independent check here rather than a cascading parameter from MainLayout, since it's a
    // single cheap DI call and this component already injects its own services.
    private bool _isDevelopment;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await CurrentUser.IsAdminAsync();
        _isDevelopment = Env.IsDevelopment();
        FeedbackPrompt.RunCompleted += OnRunCompleted;
    }

    // Draws attention to the link rather than popping a modal automatically - see
    // IFeedbackPromptService's own doc comment for why. Fires from anywhere a Helper run
    // completes; idempotent (setting an already-true flag is a no-op), so repeated runs don't
    // restart or stack anything.
    private void OnRunCompleted() => InvokeAsync(() =>
    {
        _shouldPulse = true;
        StateHasChanged();
    });

    // No Helper context - this isn't reached from a specific run, just wherever the user happens
    // to be. Clicking it is what the pulse was drawing attention to, so it stops here too.
    private Task RequestFeedback()
    {
        _shouldPulse = false;
        return FeedbackPrompt.RequestAsync(null, null);
    }

    public void Dispose() => FeedbackPrompt.RunCompleted -= OnRunCompleted;
}
