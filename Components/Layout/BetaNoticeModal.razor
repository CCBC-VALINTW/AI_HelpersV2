@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialogRef" id="beta-notice-modal" data-nosnippet>
    <button type="button" class="beta-notice-close" aria-label="Close" @onclick="DismissAsync">&times;</button>
    <h2>This site is in beta</h2>
    <p>
        AI Helpers is still in active development. Features may change, and you may
        occasionally run into rough edges or bugs.
    </p>
    <button type="button" class="btn btn-primary" @onclick="DismissAsync">Got it</button>
</dialog>

@code {
    private ElementReference _dialogRef;
    private IJSObjectReference? _module;

    // Deliberately NOT a static <script type="module"> tag (the original implementation) - this
    // app prerenders (<Routes @rendermode="InteractiveServer"> renders a static pass before the
    // real interactive circuit connects), and a static script fires during THAT static pass,
    // calling showModal() before the interactive circuit exists. The interactive takeover
    // shortly after then reconciles/replaces that prerendered DOM, tearing the dialog down and
    // discarding its native open state - real bug, seen live as "pops up then immediately
    // disappears when the page changes". OnAfterRenderAsync is documented to only fire once a
    // component is genuinely part of the interactive render tree, never during static SSR, which
    // is exactly the guarantee needed here - same fix, same reasoning as FeedbackModal never
    // having this problem in the first place (it's only ever triggered by a real post-connection
    // click, never during prerendering).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var module = await GetModuleAsync();
        if (await module.InvokeAsync<bool>("wasDismissed")) return;

        await module.InvokeVoidAsync("show", _dialogRef);
    }

    private async Task DismissAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("dismiss", _dialogRef);
    }

    private async Task<IJSObjectReference> GetModuleAsync() =>
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/betaNoticeModal.js");

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone - nothing to clean up.
            }
        }
    }
}
