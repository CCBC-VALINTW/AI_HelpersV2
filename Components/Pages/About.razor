@page "/about"
@rendermode InteractiveServer
@using AiHelpers.Services

<PageTitle>About</PageTitle>

<h1>About AI Helpers</h1>
<p class="text-muted">
    Version @Current.Version - released @Current.ReleasedAt.ToString("d MMMM yyyy, HH:mm")
</p>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">What is this?</h2>
        <p>
            AI Helpers is a Conwy County Borough Council tool that uses artificial intelligence to
            help council staff draft documents, reports, letters and other written content more
            quickly. Instead of starting from a blank page, you pick a "Helper" set up for a
            particular task - for example, drafting a committee report or a residents' letter -
            give it some information, and it generates a first draft for you to review, edit and
            use.
        </p>
        <p class="mb-0">
            Every Helper is set up by the council for a specific purpose, and the AI never
            publishes anything on its own - a person always reviews the output before it's used,
            which is why every generated document includes a review checklist at the end.
        </p>
    </div>
</div>

<h2 class="h5">What's new</h2>
<p class="text-muted small">A plain-English summary of what's changed, release by release (newest first).</p>

@foreach (var release in Releases)
{
    <div class="mb-4">
        <h3 class="h6 mb-1">
            Version @release.Version
            <span class="text-muted fw-normal">- @release.ReleasedAt.ToString("d MMMM yyyy")</span>
        </h3>
        <ul class="mb-0">
            @foreach (var highlight in release.Highlights)
            {
                <li>@highlight</li>
            }
        </ul>
    </div>
}

@code {
    // The list itself lives in Services/ReleaseHistory.cs so the nav pane can show the current
    // version too - see that file for how to add a new entry.
    private static ReleaseHistory.ReleaseNote Current => ReleaseHistory.Current;
    private static IReadOnlyList<ReleaseHistory.ReleaseNote> Releases => ReleaseHistory.Releases;
}
