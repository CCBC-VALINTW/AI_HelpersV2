@page "/admin/credentials"
@attribute [Authorize(Policy = "AdminOnly")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using AiHelpers.Data
@using AiHelpers.Data.Entities
@using AiHelpers.Data.Enums
@using AiHelpers.Providers
@using AiHelpers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject ICredentialStore CredentialStore
@inject ICurrentUserService CurrentUser

<PageTitle>Provider Credentials</PageTitle>

<h1>Provider Credentials</h1>
<p class="text-muted">Encrypted credentials used to call LLM providers. Secret values are never shown once saved - only enough to confirm you're looking at the right one.</p>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="card mb-4">
        <div class="card-header">Configured credentials</div>
        <div class="card-body p-0">
            @if (_credentials.Count == 0)
            {
                <p class="text-muted p-3 mb-0">No credentials configured yet.</p>
            }
            else
            {
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Provider</th>
                            <th>Name</th>
                            <th>Default</th>
                            <th>Created</th>
                            <th>Created by</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cred in _credentials)
                        {
                            <tr>
                                <td>@cred.Provider</td>
                                <td>@cred.Name</td>
                                <td>@(cred.IsDefault ? "Yes" : "")</td>
                                <td>@cred.CreatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</td>
                                <td>@cred.CreatedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">Set AWS Bedrock credential</div>
        <div class="card-body">
            @if (_awsExisting is not null)
            {
                <div class="alert alert-info">
                    Currently set: Access Key <code>@Mask(_awsExisting.AccessKeyId)</code>, region <code>@_awsExisting.Region</code>.
                    Saving below replaces it.
                </div>
            }

            <EditForm Model="_awsForm" OnValidSubmit="SaveAwsCredentialAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="accessKeyId">Access Key ID</label>
                    <InputText id="accessKeyId" class="form-control" @bind-Value="_awsForm.AccessKeyId" />
                    <ValidationMessage For="@(() => _awsForm.AccessKeyId)" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="secretAccessKey">Secret Access Key</label>
                    <InputText id="secretAccessKey" type="password" class="form-control" @bind-Value="_awsForm.SecretAccessKey" />
                    <ValidationMessage For="@(() => _awsForm.SecretAccessKey)" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="region">Region</label>
                    <InputText id="region" class="form-control" @bind-Value="_awsForm.Region" placeholder="eu-west-2" />
                    <ValidationMessage For="@(() => _awsForm.Region)" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="sessionToken">Session token (only for temporary STS credentials)</label>
                    <InputText id="sessionToken" type="password" class="form-control" @bind-Value="_awsForm.SessionToken" />
                </div>

                <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Saving…" : "Save credential")</button>
            </EditForm>

            @if (_saveMessage is not null)
            {
                <div class="alert alert-success mt-3 mb-0">@_saveMessage</div>
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private List<ProviderCredential> _credentials = [];
    private AwsCredentialPayload? _awsExisting;
    private AwsCredentialForm _awsForm = new();
    private string? _saveMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _credentials = await Db.ProviderCredentials
            .OrderBy(c => c.Provider)
            .ThenBy(c => c.Name)
            .ToListAsync();

        _awsExisting = await CredentialStore.GetDefaultAsync<AwsCredentialPayload>(LlmProvider.AwsBedrock);
        _loading = false;
    }

    private async Task SaveAwsCredentialAsync()
    {
        _saving = true;
        _saveMessage = null;

        var email = await CurrentUser.GetEmailAsync();
        var payload = new AwsCredentialPayload
        {
            AccessKeyId = _awsForm.AccessKeyId.Trim(),
            SecretAccessKey = _awsForm.SecretAccessKey,
            Region = _awsForm.Region.Trim(),
            SessionToken = string.IsNullOrWhiteSpace(_awsForm.SessionToken) ? null : _awsForm.SessionToken
        };

        await CredentialStore.SetDefaultAsync(LlmProvider.AwsBedrock, "Default", payload, email);

        _awsForm = new();
        _saveMessage = "Credential saved.";
        await LoadAsync();
        _saving = false;
    }

    private static string Mask(string value) => value.Length <= 4 ? "****" : value[..4] + new string('*', value.Length - 4);

    private class AwsCredentialForm
    {
        [Required] public string AccessKeyId { get; set; } = "";
        [Required] public string SecretAccessKey { get; set; } = "";
        [Required] public string Region { get; set; } = "";
        public string? SessionToken { get; set; }
    }
}
