@page "/admin/credentials"
@attribute [Authorize(Policy = "AdminOnly")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using AiHelpers.Data
@using AiHelpers.Data.Entities
@using AiHelpers.Data.Enums
@using AiHelpers.Providers
@using AiHelpers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject ICredentialStore CredentialStore
@inject ICurrentUserService CurrentUser

<PageTitle>Provider Credentials</PageTitle>

<h1>Provider Credentials</h1>
<p class="text-muted">Encrypted credentials used to call LLM providers. Secret values are never shown once saved - only enough to confirm you're looking at the right one.</p>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="card mb-4">
        <div class="card-header">Configured credentials</div>
        <div class="card-body p-0">
            @if (_credentials.Count == 0)
            {
                <p class="text-muted p-3 mb-0">No credentials configured yet.</p>
            }
            else
            {
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Provider</th>
                            <th>Name</th>
                            <th>Default</th>
                            <th>Created</th>
                            <th>Created by</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cred in _credentials)
                        {
                            <tr>
                                <td>@cred.Provider</td>
                                <td>@cred.Name</td>
                                <td>@(cred.IsDefault ? "Yes" : "")</td>
                                <td>@cred.CreatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</td>
                                <td>@cred.CreatedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">Set AWS Bedrock credential</div>
        <div class="card-body">
            @if (_awsExisting is not null)
            {
                <div class="alert alert-info">
                    Currently set:
                    @if (_awsExisting.BearerToken is not null)
                    {
                        <span>bearer token <code>@Mask(_awsExisting.BearerToken)</code></span>
                    }
                    else
                    {
                        <span>access key <code>@Mask(_awsExisting.AccessKeyId ?? "")</code></span>
                    }
                    , region <code>@_awsExisting.Region</code>. Saving below replaces it.
                </div>
            }
            else if (_credentials.Any(c => c.Provider == LlmProvider.AwsBedrock))
            {
                <div class="alert alert-warning">
                    A credential is on record but couldn't be read on this server. Saving below
                    replaces it with one this server can use.
                    @if (_awsDecryptError is not null)
                    {
                        <div class="small mt-1"><code>@_awsDecryptError</code></div>
                    }
                </div>
            }

            <EditForm Model="_awsForm" OnValidSubmit="SaveAwsCredentialAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label d-block">Authentication style</label>
                    <InputRadioGroup @bind-Value="_awsForm.AuthStyle">
                        <div class="form-check form-check-inline">
                            <InputRadio class="form-check-input" id="authBearer" Value="@AwsAuthStyle.Bearer" />
                            <label class="form-check-label" for="authBearer">Bearer token (Bedrock API key)</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <InputRadio class="form-check-input" id="authKeys" Value="@AwsAuthStyle.Keys" />
                            <label class="form-check-label" for="authKeys">Access key / secret (IAM)</label>
                        </div>
                    </InputRadioGroup>
                </div>

                @if (_awsForm.AuthStyle == AwsAuthStyle.Bearer)
                {
                    <div class="mb-3">
                        <label class="form-label" for="bearerToken">Bearer token</label>
                        <InputText id="bearerToken" type="password" class="form-control" @bind-Value="_awsForm.BearerToken" />
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label" for="accessKeyId">Access Key ID</label>
                        <InputText id="accessKeyId" class="form-control" @bind-Value="_awsForm.AccessKeyId" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="secretAccessKey">Secret Access Key</label>
                        <InputText id="secretAccessKey" type="password" class="form-control" @bind-Value="_awsForm.SecretAccessKey" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sessionToken">Session token (only for temporary STS credentials)</label>
                        <InputText id="sessionToken" type="password" class="form-control" @bind-Value="_awsForm.SessionToken" />
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label" for="region">Region</label>
                    <InputText id="region" class="form-control" @bind-Value="_awsForm.Region" placeholder="eu-west-2" />
                    <ValidationMessage For="@(() => _awsForm.Region)" />
                </div>

                @if (_validationError is not null)
                {
                    <div class="alert alert-danger">@_validationError</div>
                }

                <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Saving…" : "Save credential")</button>
            </EditForm>

            @if (_saveMessage is not null)
            {
                <div class="alert alert-success mt-3 mb-0">@_saveMessage</div>
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private List<ProviderCredential> _credentials = [];
    private AwsCredentialPayload? _awsExisting;
    private string? _awsDecryptError;
    private AwsCredentialForm _awsForm = new();
    private string? _saveMessage;
    private string? _validationError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _credentials = await Db.ProviderCredentials
            .OrderBy(c => c.Provider)
            .ThenBy(c => c.Name)
            .ToListAsync();

        try
        {
            _awsExisting = await CredentialStore.GetDefaultAsync<AwsCredentialPayload>(LlmProvider.AwsBedrock);
        }
        catch (Exception ex)
        {
            // Whatever the actual cause, a decrypt-for-preview failure must not crash this page -
            // it's the one place meant to let someone fix a stale/unreadable credential, so it has
            // to render regardless. Surfaces the real exception text rather than asserting a fixed
            // cause: this used to hardcode "Data Protection keys are DPAPI-protected machine-
            // scoped" unconditionally, which was true when first written but went stale and
            // actively misleading the moment Data Protection switched to a (supposedly
            // cross-machine-shareable) certificate instead - see project memory/git history for
            // that switch. Don't reintroduce an assumed cause here; whatever's actually thrown is
            // more useful than a guess, right or wrong.
            _awsExisting = null;
            _awsDecryptError = ex.Message;
        }
        _loading = false;
    }

    private async Task SaveAwsCredentialAsync()
    {
        _validationError = _awsForm.AuthStyle == AwsAuthStyle.Bearer
            ? (string.IsNullOrWhiteSpace(_awsForm.BearerToken) ? "Bearer token is required." : null)
            : (string.IsNullOrWhiteSpace(_awsForm.AccessKeyId) || string.IsNullOrWhiteSpace(_awsForm.SecretAccessKey)
                ? "Access Key ID and Secret Access Key are both required."
                : null);
        if (_validationError is not null) return;

        _saving = true;
        _saveMessage = null;

        var email = await CurrentUser.GetEmailAsync();
        var payload = _awsForm.AuthStyle == AwsAuthStyle.Bearer
            ? new AwsCredentialPayload { Region = _awsForm.Region.Trim(), BearerToken = _awsForm.BearerToken }
            : new AwsCredentialPayload
            {
                Region = _awsForm.Region.Trim(),
                AccessKeyId = _awsForm.AccessKeyId!.Trim(),
                SecretAccessKey = _awsForm.SecretAccessKey,
                SessionToken = string.IsNullOrWhiteSpace(_awsForm.SessionToken) ? null : _awsForm.SessionToken
            };

        await CredentialStore.SetDefaultAsync(LlmProvider.AwsBedrock, "Default", payload, email);

        _awsForm = new();
        _saveMessage = "Credential saved.";
        await LoadAsync();
        _saving = false;
    }

    private static string Mask(string value) => value.Length <= 4 ? "****" : value[..4] + new string('*', value.Length - 4);

    private enum AwsAuthStyle { Bearer, Keys }

    private class AwsCredentialForm
    {
        public AwsAuthStyle AuthStyle { get; set; } = AwsAuthStyle.Bearer;
        public string? BearerToken { get; set; }
        public string? AccessKeyId { get; set; }
        public string? SecretAccessKey { get; set; }
        public string? SessionToken { get; set; }
        [Required] public string Region { get; set; } = "";
    }
}
