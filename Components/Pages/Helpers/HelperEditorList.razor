@page "/helpers/editor"
@rendermode InteractiveServer
@using AiHelpers.Data
@using AiHelpers.Data.Entities
@using AiHelpers.Data.Enums
@using AiHelpers.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject ICurrentUserService CurrentUser

<PageTitle>Helper Editor</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-2">
    <h1 class="mb-0">Helper Editor</h1>
    <a href="/helpers/editor/new" class="btn btn-primary">+ New Helper</a>
</div>
<p class="text-muted">
    @(_isAdmin
        ? "Create and manage Helpers - General Helpers are shared with everyone, Personal ones belong to a single user."
        : "Create and manage the Helpers you own, Personal or published. Publish one to make it available to everyone, or clone an existing Helper from its run page to make your own variant.")
</p>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_helpers.Count == 0)
{
    <p class="text-muted">You haven't created any Helpers yet.</p>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <input type="search" class="form-control" placeholder="Search by name or description…"
                   @bind="_searchTerm" @bind:event="oninput" />
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="_selectedCategoryId">
                <option value="0">All categories</option>
                @foreach (var category in _categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="_selectedScopeFilter">
                <option value="">All</option>
                <option value="@HelperScope.General">General</option>
                <option value="@HelperScope.Personal">Personal</option>
            </select>
        </div>
    </div>

    var filtered = FilteredHelpers().ToList();

    @if (filtered.Count == 0)
    {
        <p class="text-muted">No Helpers match your filters.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Scope</th>
                    <th>Category</th>
                    <th>Model</th>
                    <th>Last edited</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in filtered)
                {
                    <tr>
                        <td>@h.Name</td>
                        <td><span class="badge @(h.Scope == HelperScope.General ? "text-bg-primary" : "text-bg-secondary")">@h.Scope</span></td>
                        <td>@(h.HelperCategory?.Name ?? "—")</td>
                        <td>@(h.IsExternal ? "External" : h.LlmDefinition?.Name ?? "—")</td>
                        <td class="text-muted">@h.LastModifiedAtUtc.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            <a href="@($"/helpers/editor/{h.Id}")" class="btn btn-outline-secondary btn-sm">Edit</a>
                            <a href="@($"/helpers/{h.Id}")" class="btn btn-outline-secondary btn-sm">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private bool _loading = true;
    private bool _isAdmin;
    private List<HelperDefinition> _helpers = [];
    private List<HelperCategory> _categories = [];
    private string _searchTerm = string.Empty;
    private int _selectedCategoryId;
    private string _selectedScopeFilter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var email = await CurrentUser.GetEmailAsync();
        _isAdmin = await CurrentUser.IsAdminAsync();

        var query = Db.HelperDefinitions
            .Include(h => h.HelperCategory)
            .Include(h => h.LlmDefinition)
            .AsQueryable();

        _helpers = await (_isAdmin ? query : query.Where(h => h.OwnerEmail == email))
            .OrderBy(h => h.Name)
            .ToListAsync();

        _categories = await Db.HelperCategories
            .Where(c => _helpers.Select(h => h.HelperCategoryId).Contains(c.Id))
            .OrderBy(c => c.Name)
            .ToListAsync();

        _loading = false;
    }

    private IEnumerable<HelperDefinition> FilteredHelpers()
    {
        var query = _helpers.AsEnumerable();

        if (_selectedCategoryId > 0)
        {
            query = query.Where(h => h.HelperCategoryId == _selectedCategoryId);
        }

        if (!string.IsNullOrWhiteSpace(_selectedScopeFilter) && Enum.TryParse<HelperScope>(_selectedScopeFilter, out var scope))
        {
            query = query.Where(h => h.Scope == scope);
        }

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            query = query.Where(h =>
                h.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (h.Description is not null && h.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)));
        }

        return query.OrderBy(h => h.Name);
    }
}
