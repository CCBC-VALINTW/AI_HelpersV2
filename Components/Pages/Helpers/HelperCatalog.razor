@page "/helpers"
@rendermode InteractiveServer
@using AiHelpers.Data
@using AiHelpers.Data.Entities
@using AiHelpers.Data.Enums
@using AiHelpers.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject ICurrentUserService CurrentUser

<PageTitle>Helpers</PageTitle>

<h1>Helpers</h1>
<p class="text-muted">Browse the AI Helpers available to you, or find one of your own.</p>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <input type="search" class="form-control" placeholder="Search by name or description…"
                   @bind="_searchTerm" @bind:event="oninput" />
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="_selectedCategoryId">
                <option value="0">All categories</option>
                @foreach (var category in _categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="_selectedScopeFilter">
                <option value="">All</option>
                <option value="@HelperScope.General">General</option>
                <option value="@HelperScope.Personal">Mine</option>
            </select>
        </div>
    </div>

    var filtered = FilteredHelpers().ToList();

    @if (filtered.Count == 0)
    {
        <p class="text-muted">No Helpers match your filters.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
            @foreach (var def in filtered)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@def.Name</h5>
                                <button type="button" class="btn btn-link p-0 favorite-star @(_favoriteIds.Contains(def.Id) ? "is-favorite" : "")"
                                        title="@(_favoriteIds.Contains(def.Id) ? "Remove from favourites" : "Add to favourites")"
                                        @onclick="() => ToggleFavorite(def.Id)">
                                    @(_favoriteIds.Contains(def.Id) ? "★" : "☆")
                                </button>
                            </div>
                            <span class="badge @(def.Scope == HelperScope.General ? "text-bg-primary" : "text-bg-secondary") mb-2 align-self-start">
                                @def.Scope
                            </span>
                            @if (def.HelperCategory is not null)
                            {
                                <span class="badge text-bg-light border mb-2 align-self-start">@def.HelperCategory.Name</span>
                            }
                            <p class="card-text text-muted small flex-grow-1">@Truncate(def.Description, 100)</p>
                            <p class="card-text small mb-3">
                                <span class="text-muted">Model:</span> @(def.LlmDefinition?.Name ?? "External")
                            </p>
                            <a href="@($"/helpers/{def.Id}")" class="btn btn-outline-primary btn-sm mt-auto">Open</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "category")]
    public int? CategoryId { get; set; }

    private bool _loading = true;
    private List<HelperDefinition> _helpers = [];
    private List<HelperCategory> _categories = [];
    private HashSet<int> _favoriteIds = [];
    private string _searchTerm = string.Empty;
    private int _selectedCategoryId;
    private string _selectedScopeFilter = string.Empty;
    private string _email = "";

    protected override async Task OnInitializedAsync()
    {
        _selectedCategoryId = CategoryId ?? 0;
        _email = await CurrentUser.GetEmailAsync();

        _helpers = await Db.HelperDefinitions
            .Include(h => h.HelperCategory)
            .Include(h => h.LlmDefinition)
            .Where(h => h.Scope == HelperScope.General || h.OwnerEmail == _email)
            .OrderBy(h => h.Name)
            .ToListAsync();

        _categories = await Db.HelperCategories
            .Where(c => _helpers.Select(h => h.HelperCategoryId).Contains(c.Id))
            .OrderBy(c => c.Name)
            .ToListAsync();

        _favoriteIds = (await Db.HelperFavorites
            .Where(f => f.UserEmail == _email)
            .Select(f => f.HelperDefinitionId)
            .ToListAsync())
            .ToHashSet();

        _loading = false;
    }

    private async Task ToggleFavorite(int helperId)
    {
        var existing = await Db.HelperFavorites
            .FirstOrDefaultAsync(f => f.UserEmail == _email && f.HelperDefinitionId == helperId);

        if (existing is not null)
        {
            Db.HelperFavorites.Remove(existing);
            _favoriteIds.Remove(helperId);
        }
        else
        {
            Db.HelperFavorites.Add(new HelperFavorite { UserEmail = _email, HelperDefinitionId = helperId, CreatedAt = DateTime.UtcNow });
            _favoriteIds.Add(helperId);
        }

        await Db.SaveChangesAsync();
    }

    private IEnumerable<HelperDefinition> FilteredHelpers()
    {
        var query = _helpers.AsEnumerable();

        if (_selectedCategoryId > 0)
        {
            query = query.Where(h => h.HelperCategoryId == _selectedCategoryId);
        }

        if (!string.IsNullOrWhiteSpace(_selectedScopeFilter) && Enum.TryParse<HelperScope>(_selectedScopeFilter, out var scope))
        {
            query = query.Where(h => h.Scope == scope);
        }

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            query = query.Where(h =>
                h.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (h.Description is not null && h.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)));
        }

        // Favourites float to the top, everything else keeps its existing name order beneath.
        return query.OrderByDescending(h => _favoriteIds.Contains(h.Id)).ThenBy(h => h.Name);
    }

    private static string Truncate(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "No description provided.";
        // Descriptions can contain HTML formatting (several real Helpers use <li>/<br>/<b> for
        // structure) - stripped here rather than rendered, since a character-based truncation
        // could otherwise cut off mid-tag and corrupt the rest of the card.
        var plain = System.Text.RegularExpressions.Regex.Replace(text, "<[^>]*>", " ");
        plain = System.Text.RegularExpressions.Regex.Replace(plain, @"\s+", " ").Trim();
        return plain.Length <= maxLength ? plain : plain[..maxLength].TrimEnd() + "…";
    }
}
