    private async Task ApplyEdits()
    {
        var module = await GetModuleAsync();
        var html = await module.InvokeAsync<string>("getHtml", "output");
        await module.InvokeVoidAsync("destroyEditor", "output");

        // Defense in depth: TipTap constrains structure to its own schema, but re-sanitize before
        // this becomes the new source-of-truth output that flows into BuildOutputDocument anyway.
        _output = HtmlContentSanitizer.Sanitize(html);
        _editing = false;
    }

