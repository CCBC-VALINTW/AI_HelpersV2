    private string FormatElapsed()
    {
        if (_runStartedAt is not { } start) return "";
        var elapsed = DateTime.UtcNow - start;
        return elapsed.TotalMinutes >= 1 ? $"{(int)elapsed.TotalMinutes}m {elapsed.Seconds}s" : $"{elapsed.Seconds}s";
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _attachmentError = null;

        // GetMultipleFiles throws if more than its maximum is selected in one go, rather than
        // truncating - pass a generous ceiling here and let the per-kind checks below enforce the
        // real Bedrock limits gracefully (a user-facing message, not an unhandled exception that
        // tears down the circuit).
        foreach (var file in e.GetMultipleFiles(maximumFileCount: 20))
        {
            var classification = AttachmentClassifier.ClassifyExtension(Path.GetExtension(file.Name));
            if (classification is not { } c)
            {
                _attachmentError = $"\"{file.Name}\" isn't a supported file type.";
                continue;
            }

            var supported = c.Kind == AttachmentKind.Document
                ? _helper?.LlmDefinition?.SupportsDocument
                : _helper?.LlmDefinition?.SupportsImage;
            if (supported != true)
            {
                _attachmentError = $"This Helper's model doesn't support {(c.Kind == AttachmentKind.Document ? "document" : "image")} attachments.";
                continue;
            }

            var (docs, images) = CurrentAttachmentTotals();
            var kindLimit = c.Kind == AttachmentKind.Document ? MaxDocumentAttachments : MaxImageAttachments;
            var kindCount = c.Kind == AttachmentKind.Document ? docs : images;
            if (kindCount >= kindLimit)
            {
                var kindLabel = c.Kind == AttachmentKind.Document ? "documents" : "images";
                _attachmentError = $"This run already has the maximum of {kindLimit} {kindLabel} (including any Knowledge document and context-question uploads).";
                continue;
            }

            var maxBytes = c.Kind == AttachmentKind.Image ? MaxImageBytes : MaxDocumentBytes;
            if (file.Size > maxBytes)
            {
                _attachmentError = $"\"{file.Name}\" is too large ({file.Size / 1_000_000.0:0.0} MB) - the limit is {maxBytes / 1_000_000.0:0.0} MB.";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: maxBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                _attachments.Add(new Attachment { Name = file.Name, Kind = c.Kind, Format = c.Format, Bytes = buffer.ToArray() });
            }
            catch (IOException)
            {
                _attachmentError = $"\"{file.Name}\" is too large - the limit is {maxBytes / 1_000_000.0:0.0} MB.";
            }
        }
    }

    private void RemoveAttachment(Attachment attachment) => _attachments.Remove(attachment);

    private async Task OnContextFileSelected(ContextAnswerState answer, InputFileChangeEventArgs e)
    {
        answer.Error = null;
        answer.Document = null;
        var file = e.File;
        if (file is null) return;

        var classification = AttachmentClassifier.ClassifyExtension(Path.GetExtension(file.Name));
        if (classification is not { } c)
        {
            answer.Error = $"\"{file.Name}\" isn't a supported file type.";
            return;
        }

        // answer.Document was already cleared above, so a straight replacement of this same
        // question's own upload never double-counts against itself here.
        var (docs, images) = CurrentAttachmentTotals();
        var kindLimit = c.Kind == AttachmentKind.Document ? MaxDocumentAttachments : MaxImageAttachments;
        var kindCount = c.Kind == AttachmentKind.Document ? docs : images;
        if (kindCount >= kindLimit)
        {
            var kindLabel = c.Kind == AttachmentKind.Document ? "documents" : "images";
            answer.Error = $"This run already has the maximum of {kindLimit} {kindLabel} (including any Knowledge document and other uploads).";
            return;
        }

        var maxBytes = c.Kind == AttachmentKind.Image ? MaxImageBytes : MaxDocumentBytes;
        if (file.Size > maxBytes)
        {
            answer.Error = $"\"{file.Name}\" is too large ({file.Size / 1_000_000.0:0.0} MB) - the limit is {maxBytes / 1_000_000.0:0.0} MB.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: maxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            answer.Document = new Attachment { Name = file.Name, Kind = c.Kind, Format = c.Format, Bytes = buffer.ToArray() };
        }
        catch (IOException)
        {
            answer.Error = $"\"{file.Name}\" is too large - the limit is {maxBytes / 1_000_000.0:0.0} MB.";
        }
    }

    private async Task AddUrlAttachment()
    {
        _attachmentError = null;
        var url = _urlInput.Trim();
        if (string.IsNullOrWhiteSpace(url)) return;

        var (docs, _) = CurrentAttachmentTotals();
        if (docs >= MaxDocumentAttachments)
        {
            _attachmentError = $"This run already has the maximum of {MaxDocumentAttachments} documents (including any Knowledge document and context-question uploads) - a URL fetch always counts as a document.";
            return;
        }

        _fetchingUrl = true;
        StateHasChanged();

        var result = await UrlFetch.FetchAsync(url, MaxDocumentBytes);

        _fetchingUrl = false;

        if (!result.Success || result.Bytes is null || result.Format is null)
        {
            _attachmentError = result.ErrorMessage ?? "Couldn't fetch that URL.";
            return;
        }

        var displayName = Uri.TryCreate(result.FinalUrl, UriKind.Absolute, out var finalUri)
            ? finalUri.GetLeftPart(UriPartial.Path)
            : url;

        _attachments.Add(new Attachment { Name = displayName, Kind = AttachmentKind.Document, Format = result.Format, Bytes = result.Bytes });
        _urlInput = "";
    }

    private static string AttachmentAccept(Data.Entities.LlmDefinition model)
    {
        var parts = new List<string>();
        if (model.SupportsDocument) parts.Add(".pdf,.csv,.doc,.docx,.xls,.xlsx,.html,.htm,.txt,.md,.vtt,.json");
        if (model.SupportsImage) parts.Add(".png,.jpg,.jpeg,.gif,.webp");
        return string.Join(",", parts);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_inputEditorNeedsInit && _helper is { IsExternal: false })
        {
            _inputEditorNeedsInit = false;
            var module = await GetModuleAsync();
            // Seeded from _lastInput, not always blank - on a fresh page load _lastInput is
            // already "" so this behaves the same as before for a first run, but re-expanding the
            // collapsed input card after a run needs to show what's actually there, not an empty
            // editor (the underlying state would be intact either way, but the user would see an
            // apparently-blank box for a run that already has real input behind it).
            await module.InvokeVoidAsync("createEditor", "input", _inputRef, HtmlContentSanitizer.Sanitize(_lastInput), "Paste or type the content to process here - or attach files / add a URL below.", 220);
        }

        if (_editorNeedsInit)
        {
            _editorNeedsInit = false;
            var module = await GetModuleAsync();
            await module.InvokeVoidAsync("createEditor", "output", _editorRef, HtmlContentSanitizer.Sanitize(_output ?? string.Empty), null, 512);
        }
    }

