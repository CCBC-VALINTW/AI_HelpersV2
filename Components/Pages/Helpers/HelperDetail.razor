@page "/helpers/{Id:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Text.RegularExpressions
@using AiHelpers.Contracts
@using AiHelpers.Data
@using AiHelpers.Data.Enums
@using AiHelpers.Providers
@using AiHelpers.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@inject AppDbContext Db
@inject ICurrentUserService CurrentUser
@inject IHelperInvocationService InvocationService
@inject IOrganisationalInfoService OrgInfo
@inject IUrlFetchService UrlFetch
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IFeedbackPromptService FeedbackPrompt

<PageTitle>@(_helper?.Name ?? "Helper")</PageTitle>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_helper is null)
{
    <h1>Not found</h1>
    <p class="text-muted">This Helper doesn't exist, or isn't shared with you.</p>
    <a href="/helpers" class="btn btn-outline-secondary">Back to Helpers</a>
}
else
{
    RenderFragment RenderWaitingPanel = @<div class="text-center border rounded p-4 mt-3 waiting-panel">
        <div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden">Running…</span></div>
        <p class="mb-1"><strong>Running… @FormatElapsed() elapsed</strong></p>
        <p class="fst-italic text-muted mb-3">@_waitingPhrase</p>
        <div class="waiting-idea-box mx-auto">
            <div class="small text-uppercase fw-semibold mb-1">Something to do while you wait</div>
            <div>@_waitingIdea</div>
        </div>
        <p class="text-muted small mt-3 mb-0">Long documents can take several minutes.</p>
    </div>;

    // Its own card, shown before Options and only when the Helper actually has questions -
    // stays visible after the first run (not gated behind the "Run this Helper" card) so answers
    // remain reachable and editable ahead of a Refine, same reasoning as RenderPreferenceToggles.
    RenderFragment RenderContextQuestions = @<div class="d-flex flex-column gap-3">
        @if (!string.IsNullOrWhiteSpace(_helper!.ContextQuestionsIntro))
        {
            <p class="text-muted small mb-0">@_helper.ContextQuestionsIntro</p>
        }
        @foreach (var answer in _contextAnswers)
        {
            <div>
                <label class="form-label small mb-1">
                    @answer.Question.Label
                    @if (answer.Question.IsMandatory)
                    {
                        <span class="text-danger">*</span>
                    }
                </label>
                @if (answer.Question.Type == ContextQuestionType.Text)
                {
                    <textarea class="form-control form-control-sm" rows="2" value="@answer.Text"
                              @oninput="e => answer.Text = e.Value?.ToString() ?? string.Empty"></textarea>
                }
                else if (answer.Question.Type == ContextQuestionType.Document)
                {
                    <InputFile OnChange="e => OnContextFileSelected(answer, e)" class="form-control form-control-sm" />
                    @if (answer.Document is not null)
                    {
                        <span class="text-muted small">@answer.Document.Name attached.</span>
                    }
                    @if (answer.Error is not null)
                    {
                        <div class="text-danger small">@answer.Error</div>
                    }
                }
                else if (answer.Question.Type == ContextQuestionType.Select)
                {
                    <select class="form-select form-select-sm" @bind="answer.Text">
                        <option value="">Choose…</option>
                        @foreach (var option in ContextQuestionOptions.Parse(answer.Question.OptionsJson))
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                }
                else
                {
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" checked="@answer.BoolValue"
                               @onchange="e => answer.BoolValue = (bool)e.Value!" />
                    </div>
                }
            </div>
        }
    </div>;

    // Shared between the pre- and post-output states of the Options card - both toggles apply
    // to whichever call comes next regardless of when they're set (RunOrRefine always flows
    // through the same BuildEffectiveInput).
    RenderFragment RenderPreferenceToggles = @<div class="d-flex flex-column gap-2">
        <div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="useRoleInfo" @bind="_useRoleInfo" />
                <label class="form-check-label small" for="useRoleInfo">Use my organisational info</label>
            </div>
            @if (_useRoleInfo)
            {
                <textarea class="form-control form-control-sm mt-1" rows="2"
                          placeholder="e.g. job title, service, section..." @bind="_roleInfo"></textarea>
            }
        </div>

        @if (_personalities.Count > 0)
        {
            <div>
                <label class="form-label small mb-1" for="personalitySelect">Personality</label>
                <select id="personalitySelect" class="form-select form-select-sm" @bind="_selectedPersonalityId">
                    <option value="">None</option>
                    @foreach (var p in _personalities)
                    {
                        <option value="@p.Id">@(p.Name)@(p.IsDefault ? " (default)" : "")</option>
                    }
                </select>
            </div>
        }
    </div>;

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="d-flex align-items-start gap-2">
            <button type="button" class="btn btn-link p-0 favorite-star @(_isFavorite ? "is-favorite" : "")"
                    title="@(_isFavorite ? "Remove from favourites" : "Add to favourites")" @onclick="ToggleFavorite">
                @(_isFavorite ? "★" : "☆")
            </button>
            <div>
                <h1 class="mb-1">@_helper.Name</h1>
                <p class="text-muted mb-0">@((MarkupString)(_helper.Description ?? ""))</p>
            </div>
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
            <span class="badge @(_helper.Scope == HelperScope.General ? "text-bg-primary" : "text-bg-secondary") fs-6">
                @_helper.Scope
            </span>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloneAsync" disabled="@_cloning">
                @(_cloning ? "Cloning…" : "Clone as my own")
            </button>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3 mb-4 p-3 border rounded helper-info-strip">
        @if (_helper.IsExternal)
        {
            <span><strong>External Helper</strong> - proxies to an external service rather than calling an LLM directly.</span>
        }
        else if (_helper.LlmDefinition is not null)
        {
            <div class="d-flex align-items-center gap-2">
                <strong>@_helper.LlmDefinition.Name</strong>
                @if (_helper.LlmDefinition.SupportsText) { <span class="badge text-bg-light border">Text</span> }
                @if (_helper.LlmDefinition.SupportsDocument) { <span class="badge text-bg-light border">Document</span> }
                @if (_helper.LlmDefinition.SupportsImage) { <span class="badge text-bg-light border">Image</span> }
                @if (_helper.Effort is not null) { <span class="badge text-bg-light border">Reasoning: @_helper.Effort</span> }
            </div>

            var (flagSvg, label) = ResidencyDisplay(_helper.LlmDefinition.Residency);
            <div class="d-flex align-items-center gap-2 px-2 py-1 rounded residency-badge-compact">
                <span class="residency-flag" aria-hidden="true">@((MarkupString)flagSvg)</span>
                <span class="small fw-semibold">@label</span>
            </div>
        }
        else
        {
            <span class="text-muted">No model configured.</span>
        }

        @if (_helper.HelperCategory is not null)
        {
            <span class="badge text-bg-light border">@_helper.HelperCategory.Name</span>
        }

        @if (_helper.HasKnowledge)
        {
            <span class="small text-muted">📚 Uses a knowledge source</span>
        }
        @if (_helper.ContextQuestions.Count > 0)
        {
            <span class="small text-muted">💬 Supports conversation context</span>
        }
    </div>

    @if (_helper.IsExternal)
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">This Helper opens an external tool.</span>
            <a href="@BuildExternalUrl()" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">Open in a new tab ↗</a>
        </div>
        @if (IsInsecureExternalUrl)
        {
            <div class="alert alert-warning mb-4">
                This tool is hosted at <code>@_helper.ExternalUrl</code>, which isn't served over HTTPS -
                browsers block insecure content from being embedded in this (HTTPS) page, so it can't be
                shown inline here. Use "Open in a new tab" above instead.
            </div>
        }
        else
        {
            @* Deliberately not sandboxed, unlike the model-output iframe below - ExternalUrl is an
               admin/owner-configured trusted value (same tier as Description/KnowledgePrompt), not
               untrusted model output, and the external tool likely needs real script/cookie/navigation
               access to actually function. If the site itself refuses to be framed (X-Frame-Options/
               CSP frame-ancestors) this will render blank with no catchable error - the "open in a new
               tab" link above is the fallback for that case too. *@
            <div class="external-helper-frame mb-4">
                <iframe src="@BuildExternalUrl()" class="external-helper-iframe" title="@_helper.Name"></iframe>
            </div>
        }
    }
    else
    {
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span>Run this Helper</span>
                    @if (_output is not null)
                    {
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="ToggleInputCollapsed">
                            @(_inputCollapsed ? "Show / edit ▾" : "Hide ▴")
                        </button>
                    }
                </div>
                @if (_inputCollapsed)
                {
                    <div class="card-body py-2">
                        <p class="text-muted small mb-0 fst-italic">@InputPreview()</p>
                    </div>
                }
                else
                {
                    <div class="card-body">
                        <label class="form-label" for="helperInput">Your input</label>
                        <textarea id="helperInput" @ref="_inputRef" class="mb-3 helper-input-editor"></textarea>

                        @if (_helper.LlmDefinition is { } model && (model.SupportsDocument || model.SupportsImage))
                        {
                            <div class="mb-3">
                                <label class="form-label small text-muted mb-1" for="attachmentInput">Attach files (optional)</label>
                                <InputFile id="attachmentInput" OnChange="OnFilesSelected" multiple accept="@AttachmentAccept(model)" class="form-control form-control-sm" />
                                @if (_attachmentError is not null)
                                {
                                    <div class="text-danger small mt-1">@_attachmentError</div>
                                }
                                @if (_attachments.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @foreach (var attachment in _attachments)
                                        {
                                            <span class="badge text-bg-light border d-flex align-items-center gap-2">
                                                @attachment.Name
                                                <button type="button" class="btn-close" style="font-size: 0.6rem;" aria-label="Remove attachment" @onclick="() => RemoveAttachment(attachment)"></button>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>

                            @if (model.SupportsDocument)
                            {
                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1" for="urlInput">Add content from a web page (optional)</label>
                                    <div class="d-flex gap-2">
                                        <input id="urlInput" class="form-control form-control-sm" placeholder="https://…"
                                               value="@_urlInput" @oninput="e => _urlInput = e.Value?.ToString() ?? string.Empty" />
                                        <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap" @onclick="AddUrlAttachment"
                                                disabled="@(_fetchingUrl || string.IsNullOrWhiteSpace(_urlInput))">
                                            @(_fetchingUrl ? "Fetching…" : "Add")
                                        </button>
                                    </div>
                                </div>
                            }
                        }

                        @if (_output is null && _running)
                        {
                            @RenderWaitingPanel
                        }
                    </div>
                }
            </div>

            @if (_output is not null)
            {
                <div class="card mb-4">
                    <div class="card-header">Result</div>
                    <div class="card-body">
                        @if (_running)
                        {
                            @RenderWaitingPanel
                        }
                        else if (_editing)
                        {
                            <div class="d-flex justify-content-end gap-2 mb-2">
                                <button type="button" class="btn btn-success btn-sm" @onclick="ApplyEdits">Apply changes</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                            </div>
                            <textarea @ref="_editorRef" class="helper-output-editor"></textarea>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2 flex-wrap">
                                <div class="d-flex align-items-center gap-2">
                                    <label class="form-label mb-0" for="stylesheetPicker">Stylesheet</label>
                                    <select id="stylesheetPicker" class="form-select form-select-sm w-auto" @bind="_selectedStylesheetId">
                                        @foreach (var s in _stylesheets)
                                        {
                                            <option value="@s.Id">@s.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <a class="btn btn-outline-secondary btn-sm" href="@BuildOutputDataUri()" download="@(FileNameSanitizer.Sanitize(_suggestedFileName ?? _helper.Name, fallback: "helper-output") + ".html")">Download as HTML</a>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenInNewTab">Open in new tab</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="StartEditing">Edit the result</button>
                                </div>
                            </div>
                            <iframe class="border rounded helper-output" srcdoc="@BuildOutputDocument(_output, GetSelectedCss())" sandbox=""></iframe>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            @if (_contextAnswers.Count > 0)
            {
                <div class="card mb-4">
                    <div class="card-header">Context</div>
                    <div class="card-body">
                        @RenderContextQuestions
                    </div>
                </div>
            }

            <div class="card mb-4">
                <div class="card-header">Options</div>
                <div class="card-body d-flex flex-column gap-3">
                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2 small mb-0">@_errorMessage</div>
                    }
                    else if (_budgetExceeded)
                    {
                        <div class="alert alert-warning py-2 small mb-0">
                            Monthly AI spend cap reached (£@_spend.ToString("0.00") of £@_cap.ToString("0.00")).
                        </div>
                    }

                    @RenderPreferenceToggles

                    <div>
                        @if (_output is not null)
                        {
                            <label class="form-label small mb-1" for="tweakInput">Refine this result</label>
                            <textarea id="tweakInput" class="form-control form-control-sm mb-2" rows="3"
                                      placeholder="Optional - e.g. make it more formal. Leave blank if you've just changed the input or an option above."
                                      @bind="_tweakInput" disabled="@_running"></textarea>
                        }
                        <button type="button" class="btn btn-primary btn-sm w-100" @onclick="RunOrRefine"
                                disabled="@(_running || !ContextAnswersValid || !AttachmentTotalsWithinLimits())">
                            @(_output is null
                                ? (_running ? "Running…" : "Run")
                                : (_running ? "Refining…" : "Refine"))
                        </button>
                        @if (_output is null && !ContextAnswersValid)
                        {
                            <p class="text-danger small mb-0 mt-1">Please answer all required questions above before running.</p>
                        }
                        @if (!AttachmentTotalsWithinLimits())
                        {
                            <p class="text-danger small mb-0 mt-1">@AttachmentLimitMessage()</p>
                        }
                    </div>

                    @if (_output is not null)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm w-100" @onclick="SendToEditor"
                                disabled="@(_sendingToEditor || _running || _editing)">
                            @(_sendingToEditor ? "Sending…" : "Send to editor")
                        </button>
                        <button type="button" class="btn btn-link btn-sm p-0 text-start" @onclick="StartOver">Start a new run</button>
                    }
                </div>
            </div>
        </div>
    </div>
    }

    <div class="mt-4">
        <a href="/helpers" class="btn btn-outline-secondary">Back to Helpers</a>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private Data.Entities.HelperDefinition? _helper;
    private bool _inputEditorNeedsInit;
    private bool _inputCollapsed;
    private ElementReference _inputRef;
    private bool _running;
    private DateTime? _runStartedAt;
    private CancellationTokenSource? _runProgressCts;
    private string _waitingPhrase = "";
    private string _waitingIdea = "";
    private string? _errorMessage;
    private bool _budgetExceeded;
    private decimal _spend;
    private decimal _cap;
    private string? _output;
    private string? _suggestedFileName;
    private List<Data.Entities.Stylesheet> _stylesheets = [];
    private int? _selectedStylesheetId;
    private bool _editing;
    private bool _editorNeedsInit;
    private ElementReference _editorRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _actionsModule;
    private List<Attachment> _attachments = [];
    private List<ContextAnswerState> _contextAnswers = [];

    private class ContextAnswerState
    {
        public required Data.Entities.HelperContextQuestion Question { get; set; }
        public string Text { get; set; } = "";
        public Attachment? Document { get; set; }
        public bool BoolValue { get; set; }
        public string? Error { get; set; }
    }

    // A Boolean answer is always in a definite Yes/No state (never "blank"), so Mandatory has
    // nothing extra to enforce there - only Text/Document can be left unanswered.
    private bool ContextAnswersValid => _contextAnswers.All(a => !a.Question.IsMandatory || a.Question.Type switch
    {
        ContextQuestionType.Text => !string.IsNullOrWhiteSpace(a.Text),
        ContextQuestionType.Document => a.Document is not null,
        ContextQuestionType.Select => !string.IsNullOrWhiteSpace(a.Text),
        _ => true
    });
    private string? _attachmentError;
    private string _urlInput = "";
    private bool _fetchingUrl;
    private string _email = "";
    private bool _isFavorite;
    private string _lastInput = "";
    private string _tweakInput = "";
    private bool _useRoleInfo;
    private string _roleInfo = "";
    private List<Data.Entities.PersonalityPrompt> _personalities = [];
    private string _selectedPersonalityId = "";
    private bool _sendingToEditor;

    // Confirmed against AWS's own Converse API reference (Message.content): up to 5 documents
    // (4.5MB each) and up to 20 images (3.75MB, 8000x8000px each) per request - real published
    // quotas, not a guessed conservative figure. If they're ever off, Bedrock's own 400 response
    // (surfaced verbatim by BedrockAdapter) is the real authority, same as how the temperature/
    // top_p sampling-param limits got sorted out empirically.
    //
    // The count limits apply to the COMBINED total that ends up in one Converse request, not just
    // this page's own upload picker - see CurrentAttachmentTotals, which also counts the Helper's
    // own Knowledge document (prepended server-side, see HelperInvocationService.BuildAttachments)
    // and every context-question Document answer, neither of which this page would otherwise know
    // about when deciding whether one more upload still fits.
    private const long MaxDocumentBytes = 4_500_000;
    private const long MaxImageBytes = 3_750_000;
    private const int MaxDocumentAttachments = 5;
    private const int MaxImageAttachments = 20;

    /// <summary>Every source that ends up in one combined Converse content array: the Helper's own
    /// Knowledge document (if configured), every context-question Document answer, and this page's
    /// own upload picker - counted separately by AttachmentKind since Bedrock's document and image
    /// limits are independent of each other.</summary>
    private (int Documents, int Images) CurrentAttachmentTotals()
    {
        var docs = 0;
        var images = 0;
        void Tally(AttachmentKind kind) { if (kind == AttachmentKind.Document) docs++; else images++; }

        if (_helper is { HasKnowledge: true, KnowledgeFileType: { } knowledgeFileType } &&
            AttachmentClassifier.ClassifyExtension(knowledgeFileType) is { } knowledgeClass)
        {
            Tally(knowledgeClass.Kind);
        }
        foreach (var a in _attachments) Tally(a.Kind);
        foreach (var a in _contextAnswers)
        {
            if (a.Document is not null) Tally(a.Document.Kind);
        }

        return (docs, images);
    }

    private bool AttachmentTotalsWithinLimits()
    {
        var (docs, images) = CurrentAttachmentTotals();
        return docs <= MaxDocumentAttachments && images <= MaxImageAttachments;
    }

    private string? AttachmentLimitMessage()
    {
        var (docs, images) = CurrentAttachmentTotals();
        if (docs > MaxDocumentAttachments)
        {
            return $"Too many documents for this run: {docs} (including any Knowledge document and context-question uploads) - the limit is {MaxDocumentAttachments}.";
        }
        if (images > MaxImageAttachments)
        {
            return $"Too many images for this run: {images} - the limit is {MaxImageAttachments}.";
        }
        return null;
    }

    protected override async Task OnInitializedAsync()
    {
        _email = await CurrentUser.GetEmailAsync();

        _helper = await Db.HelperDefinitions
            .Include(h => h.HelperCategory)
            .Include(h => h.LlmDefinition)
            .Include(h => h.ContextQuestions)
            .Where(h => h.Id == Id && (h.Scope == HelperScope.General || h.OwnerEmail == _email))
            .FirstOrDefaultAsync();

        if (_helper is not null)
        {
            _contextAnswers = [.. _helper.ContextQuestions
                .OrderBy(q => q.SortOrder)
                .Select(q => new ContextAnswerState { Question = q })];
        }

        _stylesheets = await Db.Stylesheets.OrderBy(s => s.Name).ToListAsync();

        _loading = false;
        if (_helper is not null)
        {
            // External Helpers never render the input editor's textarea (see the IsExternal
            // branch above) - initialising TinyMCE against it anyway throws deep inside
            // tinymce.min.js ("e.setAttribute is not a function", an invalid/default
            // ElementReference) and crashes the whole circuit, not just this component.
            _inputEditorNeedsInit = !_helper.IsExternal;
            _isFavorite = await Db.HelperFavorites.AnyAsync(f => f.UserEmail == _email && f.HelperDefinitionId == _helper.Id);
        }

        // Role info is user-editable right here (no dedicated setup flow exists for it yet).
        _roleInfo = (await Db.UserRoleInfos.FirstOrDefaultAsync(r => r.Email == _email))?.Info ?? "";
        if (string.IsNullOrWhiteSpace(_roleInfo))
        {
            // First time this user has hit the page with nothing saved yet - try to pre-fill from
            // their Entra directory profile via Graph. Best-effort only (see
            // GraphOrganisationalInfoService); once they run once, SaveRoleInfoAsync persists
            // whatever's in the box (Graph-sourced or hand-edited) and this lookup is skipped from
            // then on.
            var principal = await CurrentUser.GetPrincipalAsync();
            _roleInfo = await OrgInfo.TryGetOrganisationalInfoAsync(principal) ?? "";
        }
        _useRoleInfo = !string.IsNullOrWhiteSpace(_roleInfo);

        // Personalities are read-only/selectable here by design - they're created and edited on
        // the dedicated /personality page (Components/Pages/PersonalityProfile.razor); this page
        // only picks which one (if any) applies to the next call. Pre-selects whichever the user
        // marked as their default, if any.
        _personalities = await Db.PersonalityPrompts
            .Where(p => p.Email == _email)
            .OrderByDescending(p => p.IsDefault)
            .ThenBy(p => p.Name)
            .ToListAsync();
        _selectedPersonalityId = _personalities.FirstOrDefault(p => p.IsDefault)?.Id.ToString() ?? "";
    }

    private async Task ToggleFavorite()
    {
        if (_helper is null) return;

        var existing = await Db.HelperFavorites
            .FirstOrDefaultAsync(f => f.UserEmail == _email && f.HelperDefinitionId == _helper.Id);

        if (existing is not null)
        {
            Db.HelperFavorites.Remove(existing);
            _isFavorite = false;
        }
        else
        {
            Db.HelperFavorites.Add(new Data.Entities.HelperFavorite { UserEmail = _email, HelperDefinitionId = _helper.Id, CreatedAt = DateTime.UtcNow });
            _isFavorite = true;
        }

        await Db.SaveChangesAsync();
    }

    private bool _cloning;

    /// <summary>
    /// "Use an existing Helper as a base for my own variant" - a full copy of every configured
    /// field (including a deep copy of ContextQuestions, not shared rows - they cascade-delete
    /// with their own Helper, so sharing would be invalid anyway), always landing as Personal and
    /// owned by whoever clicked Clone, regardless of the source Helper's own scope/owner. Works
    /// for any Helper this page could load in the first place (General, or one already owned by
    /// this user) - no extra check needed here since that's already enforced by OnInitializedAsync's
    /// own query. Navigates straight into the editor so the user can start customising immediately.
    /// </summary>
    private async Task CloneAsync()
    {
        if (_helper is null || _cloning) return;
        _cloning = true;

        var clone = new Data.Entities.HelperDefinition
        {
            Name = $"{_helper.Name} (My copy)",
            Description = _helper.Description,
            Scope = HelperScope.Personal,
            OwnerEmail = _email,
            HelperCategoryId = _helper.HelperCategoryId,
            IsExternal = _helper.IsExternal,
            ExternalUrl = _helper.ExternalUrl,
            LlmDefinitionId = _helper.LlmDefinitionId,
            Effort = _helper.Effort,
            Creativity = _helper.Creativity,
            Adherence = _helper.Adherence,
            CreativityAdjustmentAllowance = _helper.CreativityAdjustmentAllowance,
            AdherenceAdjustmentAllowance = _helper.AdherenceAdjustmentAllowance,
            PrimaryPurpose = _helper.PrimaryPurpose,
            Methodology = _helper.Methodology,
            StyleTone = _helper.StyleTone,
            OutputFormat = _helper.OutputFormat,
            TargetAudience = _helper.TargetAudience,
            SpecialInstructions = _helper.SpecialInstructions,
            ContextQuestionsIntro = _helper.ContextQuestionsIntro,
            HasKnowledge = _helper.HasKnowledge,
            KnowledgeData = _helper.KnowledgeData,
            KnowledgeFileType = _helper.KnowledgeFileType,
            KnowledgePrompt = _helper.KnowledgePrompt,
            DefaultStylesheetId = _helper.DefaultStylesheetId,
            OutputSchemaJson = _helper.OutputSchemaJson,
            ContextQuestions = [.. _helper.ContextQuestions.OrderBy(q => q.SortOrder).Select(q => new Data.Entities.HelperContextQuestion
            {
                Label = q.Label,
                Type = q.Type,
                IsMandatory = q.IsMandatory,
                UsageInstruction = q.UsageInstruction,
                OptionsJson = q.OptionsJson,
                SortOrder = q.SortOrder
            })]
        };

        Db.HelperDefinitions.Add(clone);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/helpers/editor/{clone.Id}");
    }

    /// <summary>
    /// Collapsing reads the live editor content back into _lastInput before tearing it down (so
    /// nothing typed is lost); expanding re-creates it seeded from _lastInput via
    /// _inputEditorNeedsInit, the same create/destroy lifecycle already used for the output
    /// editor's own edit mode (StartEditing/CancelEdit/ApplyEdits).
    /// </summary>
    private async Task ToggleInputCollapsed()
    {
        if (_inputCollapsed)
        {
            _inputCollapsed = false;
            _inputEditorNeedsInit = true;
        }
        else
        {
            var module = await GetModuleAsync();
            var rawInput = await module.InvokeAsync<string>("getHtml", "input");
            _lastInput = HtmlContentSanitizer.Sanitize(rawInput);
            await module.InvokeVoidAsync("destroyEditor", "input");
            _inputCollapsed = true;
        }
    }

    /// <summary>
    /// The single Run/Refine button's handler, for both the first run and every refinement after
    /// it (V1's `{#tweak}` mechanism, kept deliberately simple per Will's direction - a real
    /// multi-turn conversation belongs in the future Helper editor/designer phase, not here).
    /// Deliberately unconditional now - this used to require the tweak box to be non-blank or an
    /// option to have visibly changed since the last run, but that check couldn't see a change to
    /// the input text/attachments/URL itself (those live in the TinyMCE editor and JS-side state,
    /// not a plain bound field, so there was no cheap way to fingerprint them) - a real, reported
    /// bug: editing the input and nothing else left the button permanently disabled. Simpler and
    /// more robust to just always allow it once the basic preconditions (not already running, all
    /// required context questions answered) are met, same as Run always was - trust the user
    /// rather than trying to out-guess every way the "next call" could differ from the last one.
    /// </summary>
    private async Task RunOrRefine()
    {
        if (_helper is null) return;

        if (_editing)
        {
            var module = await GetModuleAsync();
            await module.InvokeVoidAsync("destroyEditor", "output");
            _editing = false;
        }

        // Reading the input editor's live content, folding in any typed tweak, and collapsing/
        // destroying the editor on success all now live in ExecuteAsync itself, in that order -
        // see its own comment for why the order specifically matters.
        await ExecuteAsync();
    }

    /// <summary>
    /// The additional "next step" after refining in place (see this page's own build report for
    /// the scoping decision) - persists the currently-shown _output as a new GeneratedDocument
    /// record and hands off to the standalone final-polish editor (Components/Pages/Documents/
    /// DocumentEditor.razor). Deliberately does not touch _output/_lastInput/etc. itself
    /// afterwards - this page's own refine loop is untouched by sending a copy elsewhere, matching
    /// the requirement that this be additive, not a replacement for it.
    /// </summary>
    private async Task SendToEditor()
    {
        if (_helper is null || _output is null) return;

        _sendingToEditor = true;
        StateHasChanged();
        try
        {
            var document = new Data.Entities.GeneratedDocument
            {
                HelperDefinitionId = _helper.Id,
                CreatedByEmail = _email,
                Title = _suggestedFileName ?? _helper.Name,
                // Deliberately NOT sanitized - the structured editor preserves the original
                // document's styling/interactivity verbatim by design, see its own comments.
                HtmlContent = _output,
                // Carries over whatever's selected in the preview above right now, so the editor
                // opens looking the same as what was just reviewed - the editor can change it
                // afterwards via its own picker.
                StylesheetId = _selectedStylesheetId,
                CreatedAtUtc = DateTime.UtcNow,
                LastModifiedAtUtc = DateTime.UtcNow,
            };
            Db.GeneratedDocuments.Add(document);
            await Db.SaveChangesAsync();

            // Opens in a new tab rather than navigating this one away - the whole point is that
            // this page's own state (the run's output, refine history, any options set) stays
            // exactly as it was, so there's actually nothing to "get back to" in the first place
            // rather than relying on a Back link to a page that would otherwise reload blank.
            await JS.InvokeVoidAsync("open", $"/documents/{document.Id}", "_blank");
        }
        finally
        {
            _sendingToEditor = false;
        }
    }

    private void StartOver()
    {
        _output = null;
        _suggestedFileName = null;
        _errorMessage = null;
        _budgetExceeded = false;
        _lastInput = "";
        _tweakInput = "";
        _attachments.Clear();
        _attachmentError = null;
        _contextAnswers = [.. _contextAnswers.Select(a => new ContextAnswerState { Question = a.Question })];
        _selectedStylesheetId = null;
        _editing = false;
        _inputCollapsed = false;
        _inputEditorNeedsInit = true;
    }

    /// <summary>
    /// Shared core for a fresh run and a tweak/refinement - both are just a single stateless call
    /// with a (possibly extended) input string, no conversation history involved.
    /// </summary>
    private async Task ExecuteAsync()
    {
        if (_helper is null) return;

        // Belt-and-braces - the Run/Refine button is already disabled while this is true, but
        // this guards direct calls to ExecuteAsync (e.g. a stale render) from ever reaching
        // Bedrock with a combined attachment count it will just reject outright.
        if (!AttachmentTotalsWithinLimits()) return;

        // If the input card is currently expanded (either the first run, or the user re-opened it
        // to edit ahead of a refine), the TinyMCE editor - not _lastInput - holds the live truth.
        // Must happen BEFORE the tweak fold-in below, not after - real bug this was fixed from:
        // folding the tweak into _lastInput first and THEN overwriting _lastInput from the editor
        // silently discarded whatever had just been typed into the tweak box, any time the main
        // input card also happened to be expanded.
        if (!_inputCollapsed && !_helper.IsExternal)
        {
            var inputModule = await GetModuleAsync();
            var rawInput = await inputModule.InvokeAsync<string>("getHtml", "input");
            _lastInput = HtmlContentSanitizer.Sanitize(rawInput);
        }

        var tweak = _tweakInput.Trim();
        _tweakInput = "";
        if (!string.IsNullOrWhiteSpace(tweak))
        {
            _lastInput = string.IsNullOrWhiteSpace(_lastInput)
                ? tweak
                : $"{_lastInput}\n\nAdditional refinement instruction: {tweak}";
        }

        var effectiveInput = BuildEffectiveInput(_lastInput);

        _running = true;
        _runStartedAt = DateTime.UtcNow;
        _errorMessage = null;
        _budgetExceeded = false;
        RotateWaitingContent();
        StateHasChanged();

        _runProgressCts = new CancellationTokenSource();
        _ = TickRunProgress(_runProgressCts.Token);

        try
        {
            await SaveRoleInfoAsync();

            var email = await CurrentUser.GetEmailAsync();
            var effectiveAttachments = _attachments
                .Concat(_contextAnswers.Where(a => a.Document is not null).Select(a => a.Document!))
                .ToList();
            var outcome = await InvocationService.RunAsync(_helper, effectiveInput, email, effectiveAttachments);

            _budgetExceeded = outcome.BudgetExceeded;
            _spend = outcome.Spend;
            _cap = outcome.Cap;
            _errorMessage = outcome.ErrorMessage;

            var newOutput = outcome.Response?.Documents.FirstOrDefault()?.Content;
            if (newOutput is not null)
            {
                _output = newOutput;
                // Regenerated on every run/refine, same as _output itself - the content just
                // changed, so the suggestion should reflect it rather than staying stuck on
                // whatever the first run produced.
                _suggestedFileName = outcome.Response?.SuggestedFileName ?? _helper.Name;

                // Pulses the NavMenu "Feedback" link rather than popping a modal - see
                // IFeedbackPromptService's own doc comment for why. Idempotent, fine to call on
                // every run/refine, not just the first.
                FeedbackPrompt.NotifyRunCompleted();

                // Mirrors V1: every Helper effectively has a stylesheet selected (even if it's an
                // inert "No Stylesheet" one) - default to the Helper's own choice on the first run
                // only; a later tweak shouldn't reset a stylesheet the user deliberately picked
                // while reviewing the result.
                _selectedStylesheetId ??= _helper.DefaultStylesheetId
                    ?? _stylesheets.FirstOrDefault(s => !HasRealStyling(s.Css))?.Id;

                // Collapse the input card on every successful run/refine, not just the first -
                // its content is already synced into _lastInput above, so nothing is lost by
                // tearing the editor down; the user can re-expand it via the card header to edit
                // again ahead of a later refine.
                if (!_inputCollapsed)
                {
                    var inputModule = await GetModuleAsync();
                    await inputModule.InvokeVoidAsync("destroyEditor", "input");
                    _inputCollapsed = true;
                }
            }
        }
        finally
        {
            _runProgressCts.Cancel();
            _runProgressCts = null;
            _running = false;
            _runStartedAt = null;
        }
    }

    /// <summary>
    /// Folds the "use my organisational info"/"use my personality" toggles into the input, V1's
    /// exact framing (from the Granicus request template) for each. Applied fresh at call time
    /// from the current toggle state, not baked into _lastInput, so turning a toggle off before a
    /// later tweak actually stops sending it.
    /// </summary>
    private string BuildEffectiveInput(string baseInput)
    {
        var parts = new List<string>();
        if (_useRoleInfo && !string.IsNullOrWhiteSpace(_roleInfo))
        {
            parts.Add($"Here is my role information, which you can use to contextualise or frame your response, or use directly in the output: {_roleInfo}");
        }
        if (int.TryParse(_selectedPersonalityId, out var personalityId) &&
            _personalities.FirstOrDefault(p => p.Id == personalityId) is { } personality)
        {
            parts.Add($"Personality traits to use to colour the style of your response: {personality.Prompt}");
        }
        // Shared with the Helper Editor's preview facility (ContextAnswerFormatter) so the two
        // can't silently drift on formatting - reinforced again in BedrockAdapter's system prompt
        // (recency-weighted, see ContextAnswersReinforcement) since these answers can now gate
        // whether whole sections/features appear at all, not just add background colour.
        var contextBlock = ContextAnswerFormatter.BuildContextBlock(_contextAnswers.Select(a =>
            new ContextAnswerFormatter.Answer(a.Question.Label, a.Question.Type, a.Question.UsageInstruction, a.Text, a.Document, a.BoolValue)));
        if (contextBlock is not null)
        {
            parts.Add(contextBlock);
        }
        parts.Add(baseInput);
        return string.Join("\n\n", parts);
    }

    private async Task SaveRoleInfoAsync()
    {
        var trimmed = _roleInfo.Trim();
        if (!_useRoleInfo || trimmed.Length == 0) return;

        var existing = await Db.UserRoleInfos.FirstOrDefaultAsync(r => r.Email == _email);
        if (existing is null)
        {
            Db.UserRoleInfos.Add(new Data.Entities.UserRoleInfo { Email = _email, Info = trimmed });
        }
        else if (existing.Info != trimmed)
        {
            existing.Info = trimmed;
        }
        else
        {
            return;
        }

        await Db.SaveChangesAsync();
    }

    /// <summary>
    /// Real Helper calls have taken 20+ minutes for long documents (see the HttpClient.Timeout
    /// bump in Program.cs) - without this, a long wait with zero visible change looks identical
    /// to a hung app. Ticks every 5s via InvokeAsync since this runs as a detached background
    /// task, not inline in the component's own render flow.
    /// </summary>
    private async Task TickRunProgress(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(5), token);
                RotateWaitingContent();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // Expected once the run completes and cancels this loop.
        }
    }

