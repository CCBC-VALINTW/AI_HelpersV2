    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyEditor", "input");
                await _module.InvokeVoidAsync("destroyEditor", "output");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (e.g. browser tab closed) - nothing to clean up.
            }
        }

        if (_actionsModule is not null)
        {
            try
            {
                await _actionsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone - nothing to clean up.
            }
        }
    }

    private string? GetSelectedCss() =>
        _stylesheets.FirstOrDefault(s => s.Id == _selectedStylesheetId)?.Css;

    // A stylesheet row can exist purely as a placeholder (V1's migrated "No Stylesheet" row is
    // literally the empty tag "<style></style>") - OutputDocumentBuilder.HasRealStyling checks by
    // content, not by name, so any other near-empty stylesheet behaves the same way. See
    // Services/OutputDocumentBuilder.cs for the full rationale (shared with the Helper Editor's
    // preview facility so the two can't drift on stylesheet handling).
    private static bool HasRealStyling(string? css) => OutputDocumentBuilder.HasRealStyling(css);

    private static string BuildOutputDocument(string bodyHtml, string? stylesheetCss) =>
        OutputDocumentBuilder.Build(bodyHtml, stylesheetCss);

    /// <summary>
    /// Some Helpers produce full interactive HTML apps (charts, drill-downs, embedded scripts) -
    /// the preview iframe's sandbox="" deliberately blocks all script execution (that's what
    /// fixed the earlier XSS/style-leak issue), so those never worked there and never will. This
    /// is V1's escape hatch (download / open in a new tab so the app can "run freely") rather
    /// than an alternative to the sandboxed preview.
    ///
    /// Used for "Download as HTML" only - a data: URI with the `download` attribute is a save
    /// action, not a navigation, so it isn't affected by browsers blocking top-level navigation
    /// to data: URLs (confirmed in testing: this is why "Open in new tab" needed a different
    /// mechanism entirely - see wwwroot/js/outputActions.js). Still genuinely isolated regardless:
    /// a data: URI gets a separate, opaque origin, so whatever scripts the downloaded file
    /// contains have no access to this app's session cookie if later opened, unlike serving it
    /// from this app's own origin would. A blob: URL was considered instead but rejected: unlike
    /// data:, a blob: URL's origin for same-origin-policy purposes is the CREATING page's origin,
    /// so script inside it could still make authenticated same-origin requests back to this app
    /// using the ambient session cookie - it wouldn't actually provide the isolation this needs.
    /// </summary>
    private string BuildOutputDataUri() =>
        "data:text/html;charset=utf-8;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(BuildOutputDocument(_output!, GetSelectedCss())));

    /// <summary>Short plain-text preview shown when the input card is collapsed, so there's still
    /// some visibility into what's there without needing to expand it every time.</summary>
    private string InputPreview()
    {
        if (string.IsNullOrWhiteSpace(_lastInput)) return "(no text input)";
        var plain = Regex.Replace(_lastInput, "<[^>]*>", " ");
        plain = Regex.Replace(plain, @"\s+", " ").Trim();
        if (plain.Length == 0) return "(no text input)";
        return plain.Length <= 140 ? plain : plain[..140].TrimEnd() + "…";
    }

    private string BuildExternalUrl()
    {
        var url = _helper!.ExternalUrl ?? "";
        var separator = url.Contains('?') ? '&' : '?';
        return $"{url}{separator}email={Uri.EscapeDataString(_email)}";
    }

    // This app is always served over HTTPS - a plain http:// ExternalUrl can never be embedded in
    // an iframe here, browsers block it as mixed content regardless of anything this app does.
    private bool IsInsecureExternalUrl =>
        Uri.TryCreate(_helper?.ExternalUrl, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttp;

    /// <summary>
    /// V1 showed a literal flag + "Processed in X" line so data residency was immediately
    /// obvious, not buried in muted small text - reinstated here rather than just naming the
    /// enum value. V1 inferred EU-vs-not from the model identifier string; V2's explicit
    /// ModelResidency enum makes that direct, and adds a real "Global" case V1 didn't visually
    /// distinguish.
    ///
    /// Uses small self-authored inline SVGs rather than Unicode flag emoji (🇬🇧/🇪🇺) - Windows'
    /// emoji font support for flags is inconsistent across browser/OS build combinations and
    /// commonly doesn't render them at all, showing nothing. SVG has no such font dependency and
    /// renders identically everywhere. Also avoids re-introducing V1's external Wikimedia image
    /// hotlink - this content is developer-authored, static markup, so MarkupString is safe here
    /// (unlike anywhere this project renders model/user-supplied content).
    /// </summary>
    private static (string FlagSvg, string Label) ResidencyDisplay(ModelResidency residency) => residency switch
    {
        ModelResidency.UK => (UkFlagSvg, "Processed in the UK"),
        ModelResidency.EU => (EuFlagSvg, "Processed in the EU"),
        _ => (GlobalFlagSvg, "No fixed data residency"),
    };

