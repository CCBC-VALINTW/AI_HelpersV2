@page "/documents/{Id:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using AiHelpers.Data
@using AiHelpers.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@inject AppDbContext Db
@inject ICurrentUserService CurrentUser
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@(_document?.Title ?? "Document")</PageTitle>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_document is null)
{
    <h1>Not found</h1>
    <p class="text-muted">This document doesn't exist, or isn't yours.</p>
    <a href="/documents" class="btn btn-outline-secondary">Back to Documents</a>
}
else
{
    <div class="mb-3">
        <label class="form-label small mb-1" for="docTitle">Title</label>
        <input id="docTitle" class="form-control form-control-lg" maxlength="256" value="@_title"
               @oninput="e => _title = e.Value?.ToString() ?? string.Empty" />
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_title))">
                @(_busy ? "Saving…" : "Save")
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyToClipboardAsync" disabled="@_busy">Copy to clipboard</button>
            @if (_statusMessage is not null)
            {
                <span class="text-muted small">@_statusMessage</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0" for="docStylesheetPicker">Stylesheet</label>
            <select id="docStylesheetPicker" class="form-select form-select-sm w-auto"
                    @bind="_selectedStylesheetId" @bind:after="OnStylesheetChanged" disabled="@_busy">
                @foreach (var s in _stylesheets)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small me-1">Export:</span>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ExportDocxAsync" disabled="@_busy">Word (.docx)</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PrintAsync" disabled="@_busy">PDF</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ExportHtmlAsync" disabled="@_busy">HTML</button>
        </div>
    </div>

    <p class="text-muted small">Word and HTML export save your latest changes first, then download the file. PDF saves first, then opens your browser's print dialog on the live preview itself - choose "Save as PDF" (or your PDF printer) as the destination.</p>
    <p class="text-muted small">Click any piece of text in the preview to edit just that element - the rest of the document's layout is left alone.</p>

    <div @ref="_editorRef" class="structured-editor-container"></div>

    <div class="mt-4 d-flex gap-2">
        @if (_document.HelperDefinition is not null)
        {
            <a href="@($"/helpers/{_document.HelperDefinition.Id}")" class="btn btn-outline-secondary">← Back to @_document.HelperDefinition.Name</a>
        }
        <a href="/documents" class="btn btn-outline-secondary">Back to Documents</a>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    // Key wwwroot/js/structuredEditor.js's own instances Map uses for this page's single editor
    // instance - distinct from HelperDetail.razor's "input"/"output" ids, though that wouldn't
    // matter anyway since each page is its own circuit/component instance.
    private const string EditorId = "document";

    // There's no shared export-format enum any more: all three exports now take genuinely different
    // routes - HTML navigates to a GET, Word POSTs browser-rasterised markup (see ExportDocxAsync),
    // and PDF never leaves the client at all (see PrintAsync) - so there was nothing left to switch
    // on.

    private bool _loading = true;
    private Data.Entities.GeneratedDocument? _document;
    private string _title = "";
    private string _email = "";
    private bool _busy;
    private string? _statusMessage;
    private bool _editorNeedsInit;
    private ElementReference _editorRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _actionsModule;
    private List<Data.Entities.Stylesheet> _stylesheets = [];
    private int? _selectedStylesheetId;

    protected override async Task OnInitializedAsync()
    {
        _email = await CurrentUser.GetEmailAsync();

        // Same "doesn't exist" vs "isn't yours" collapse as HelperDetail.razor's own Personal-scope
        // query - documents are private to whoever sent them here, no sharing/admin override in
        // this first pass (see the project's build report), so this deliberately doesn't
        // distinguish the two cases to a caller probing IDs.
        _document = await Db.GeneratedDocuments
            .Include(d => d.HelperDefinition)
            .FirstOrDefaultAsync(d => d.Id == Id && d.CreatedByEmail == _email);

        _stylesheets = await Db.Stylesheets.OrderBy(s => s.Name).ToListAsync();

        if (_document is not null)
        {
            _title = _document.Title;
            // A document sent here before this picker existed has StylesheetId null forever - falls
            // back to "No Stylesheet" rather than guessing, matching HelperDetail.razor's own default.
            _selectedStylesheetId = _document.StylesheetId
                ?? _stylesheets.FirstOrDefault(s => !OutputDocumentBuilder.HasRealStyling(s.Css))?.Id;
            _editorNeedsInit = true;
        }

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_editorNeedsInit)
        {
            _editorNeedsInit = false;
            var module = await GetModuleAsync();
            await module.InvokeVoidAsync("createEditor", EditorId, _editorRef,
                _document?.HtmlContent ?? "", GetSelectedCss());
        }
    }

    private string? GetSelectedCss() =>
        _stylesheets.FirstOrDefault(s => s.Id == _selectedStylesheetId)?.Css;

    /// <summary>Reloads the preview with the newly-picked stylesheet composed in - reads back
    /// whatever's currently in the editor first so any not-yet-saved edits survive the swap, same
    /// as recreating the iframe is the only way to change srcdoc-based content.</summary>
    private async Task OnStylesheetChanged()
    {
        if (_document is null) return;

        var module = await GetModuleAsync();
        var currentHtml = await module.InvokeAsync<string>("getHtml", EditorId);
        await module.InvokeVoidAsync("createEditor", EditorId, _editorRef, currentHtml, GetSelectedCss());
    }

    private async Task SaveAsync()
    {
        if (_document is null || string.IsNullOrWhiteSpace(_title)) return;

        _busy = true;
        _statusMessage = null;
        StateHasChanged();

        try
        {
            var module = await GetModuleAsync();
            var raw = await module.InvokeAsync<string>("getHtml", EditorId);

            // Re-sanitized here even though it's already-sanitized content being re-edited -
            // contenteditable can carry arbitrary HTML in from the clipboard on paste, same reason
            // HelperDetail.razor's ApplyEdits re-sanitizes rather than trusting the editor's schema
            // alone.
            _document.Title = _title.Trim();
            _document.HtmlContent = raw;
            _document.StylesheetId = _selectedStylesheetId;
            _document.LastModifiedAtUtc = DateTime.UtcNow;
            await Db.SaveChangesAsync();

            _title = _document.Title;
            _statusMessage = $"Saved at {_document.LastModifiedAtUtc.ToLocalTime():HH:mm:ss}";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>HTML export. Saves first so the download reflects what's currently in the editor,
    /// not whatever was last explicitly saved - this endpoint reads the persisted record, it has no
    /// access to this circuit's live preview/edit-panel state.
    /// <para>
    /// A real browser navigation (not a SignalR/JS-interop call) so the server can respond with
    /// Content-Disposition: attachment and actual bytes - see Program.cs's export endpoint doc
    /// comment for why this isn't a data: URI download link like HelperDetail's own. The browser
    /// downloads the file without leaving this page (an attachment response doesn't unload the
    /// current document), so the circuit survives this untouched.
    /// </para>
    /// </summary>
    private async Task ExportHtmlAsync()
    {
        await SaveAsync();
        if (_document is null) return;

        Nav.NavigateTo($"/documents/{_document.Id}/export/html", forceLoad: true);
    }

    /// <summary>
    /// Word export. Takes a different route to the HTML one above because Word ignores inline SVG,
    /// which is how Helpers draw their charts: the live markup is rasterised here in the browser
    /// (there's no canvas server-side) and POSTed to the converter, rather than the server reading
    /// the saved copy. A by-product is that this always converts exactly what's on screen, so the
    /// save below is about keeping the stored document current rather than about the download's
    /// contents.
    /// </summary>
    private async Task ExportDocxAsync()
    {
        await SaveAsync();
        if (_document is null) return;

        _busy = true;
        try
        {
            var editor = await GetModuleAsync();
            var liveHtml = await editor.InvokeAsync<string>("getHtml", EditorId);

            _actionsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/outputActions.js");
            // The stylesheet is passed separately because this is a body fragment, not a styled
            // document - without it a chart taking its colours from the stylesheet rasterises bare.
            var prepared = await _actionsModule.InvokeAsync<RasterizedHtml>("rasterizeSvgs", liveHtml, GetSelectedCss() ?? "");

            var fileName = $"{FileNameSanitizer.Sanitize(_title)}.docx";
            var downloaded = await _actionsModule.InvokeAsync<bool>(
                "postHtmlForDownload", $"/documents/{_document.Id}/export/docx", prepared.Html, fileName);

            _statusMessage = downloaded
                ? $"Word document downloaded.{DescribeGraphics(prepared)}"
                : "Couldn't produce the Word document - nothing was downloaded.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Only says anything when there were graphics to deal with - a text-only document
    /// shouldn't get a sentence about charts appended to its download message.</summary>
    private static string DescribeGraphics(RasterizedHtml prepared) => prepared switch
    {
        { Failed: > 0 } => $" {prepared.Converted} of {prepared.Converted + prepared.Failed} graphics became images - the rest couldn't be converted and won't appear in it.",
        { Converted: 0 } => "",
        { Converted: 1 } => " Its graphic was converted to an image so Word can show it.",
        _ => $" Its {prepared.Converted} graphics were converted to images so Word can show them.",
    };

    /// <summary>PDF's export button - unlike the Word/HTML exports' server round trip, this
    /// stays entirely client-side: save first (same reasoning as those - the
    /// export should reflect what's currently in the editor), then ask the SAME live preview iframe
    /// the user has been looking at to print itself via the browser's native print-to-PDF. This
    /// replaces the old PdfRenderer/PDFsharp-MigraDoc pipeline, which had to reconstruct the
    /// document as PDF primitives from a parsed Block model and couldn't represent real CSS - genuine
    /// browser print-to-PDF is WYSIWYG by construction instead. See structuredEditor.js's
    /// printDocument() doc comment for exactly how the trigger reaches the sandboxed iframe.</summary>
    private async Task PrintAsync()
    {
        await SaveAsync();
        if (_document is null) return;

        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("printDocument", EditorId);
    }

    /// <summary>
    /// V1's "Copy to Clipboard - Rich" button, replicated here as well as on the run page - takes
    /// the live preview's current content, wraps it with the selected stylesheet exactly as the
    /// HTML export does, and puts that on the clipboard as its HTML flavour so a paste into Word or
    /// Outlook keeps the formatting (see outputActions.js's copyToClipboard).
    /// <para>
    /// Deliberately does NOT save first, unlike every export button above: getHtml reads the live
    /// editor, so the copy already includes unsaved edits, and committing a database write as a
    /// side effect of "copy" would be a surprise. The export buttons only save because a server
    /// round trip genuinely can't see the browser's unsaved state.
    /// </para>
    /// </summary>
    private async Task CopyToClipboardAsync()
    {
        var module = await GetModuleAsync();
        var html = OutputDocumentBuilder.Build(await module.InvokeAsync<string>("getHtml", EditorId), GetSelectedCss());

        _actionsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/outputActions.js");
        var result = await _actionsModule.InvokeAsync<ClipboardCopyResult>("copyToClipboard", html, HtmlToPlainText.Convert(html));

        _statusMessage = result.Describe();
    }

    private async Task<IJSObjectReference> GetModuleAsync() =>
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/structuredEditor.js");

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyEditor", EditorId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (e.g. browser tab closed) - nothing to clean up. The
                // HTML export's forceLoad navigation doesn't reach this: a Content-Disposition:
                // attachment response triggers a download without the browser unloading the
                // current page, so the circuit survives it.
            }
        }

        if (_actionsModule is not null)
        {
            try
            {
                await _actionsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Same as above.
            }
        }
    }
}
