@page "/recent-runs"
@rendermode InteractiveServer
@using AiHelpers.Data
@using AiHelpers.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject ICurrentUserService CurrentUser

<PageTitle>Recent Runs</PageTitle>

<h1>Recent Runs</h1>
<p class="text-muted">
    Every Helper run's output, kept automatically for 7 days regardless of whether you saved it -
    a safety net if you navigate away or lose your place before sending it to the editor. For
    anything you want to keep longer, use <a href="/documents">Documents</a> instead.
</p>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_entries.Count == 0)
{
    <p class="text-muted">No runs in the last 7 days.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Helper</th>
                    <th>Generated</th>
                    <th>Expires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td>@(entry.HelperName ?? "—")</td>
                        <td class="text-muted">@entry.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                        <td class="text-muted">@entry.CreatedAtUtc.AddDays(7).ToLocalTime().ToString("d MMM")</td>
                        <td class="text-end"><a href="@($"/recent-runs/{entry.CallbackGuid}")" class="btn btn-outline-primary btn-sm">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private List<Data.Entities.CallbackEntry> _entries = [];

    protected override async Task OnInitializedAsync()
    {
        var email = await CurrentUser.GetEmailAsync();
        _entries = await Db.CallbackEntries
            .Where(c => c.CreatedByEmail == email)
            .OrderByDescending(c => c.CreatedAtUtc)
            .ToListAsync();
        _loading = false;
    }
}
