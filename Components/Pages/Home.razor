@page "/"
@rendermode InteractiveServer
@using AiHelpers.Data
@using AiHelpers.Data.Enums
@using AiHelpers.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject ICurrentUserService CurrentUser

<PageTitle>AI Helpers</PageTitle>

<h1>AI Helpers</h1>
<p class="text-muted">Welcome back, @_displayName.</p>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card text-center">
                <div class="card-body">
                    <div class="display-6">@_generalCount</div>
                    <div class="text-muted">General Helpers</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card text-center">
                <div class="card-body">
                    <div class="display-6">@_myCount</div>
                    <div class="text-muted">Your Helpers</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card text-center">
                <div class="card-body">
                    <div class="display-6">@_categories.Count</div>
                    <div class="text-muted">Categories</div>
                </div>
            </div>
        </div>
    </div>

    <a href="/helpers" class="btn btn-primary mb-4">Browse all Helpers</a>

    @if (_favorites.Count > 0)
    {
        <h2 class="h4">Your favourites</h2>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-2 mb-4">
            @foreach (var favorite in _favorites)
            {
                <div class="col">
                    <a href="@($"/helpers/{favorite.Id}")" class="text-decoration-none">
                        <div class="card h-100 category-tile favorite-tile">
                            <div class="card-body">
                                <div class="category-tile-name">★ @favorite.Name</div>
                                @if (favorite.HelperCategory is not null)
                                {
                                    <div class="category-tile-count">@favorite.HelperCategory.Name</div>
                                }
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <h2 class="h4">Categories</h2>
    @if (_categories.Count == 0)
    {
        <p class="text-muted">No categories yet.</p>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-2 category-tiles">
            @foreach (var (category, count) in _categories)
            {
                <div class="col">
                    <a href="@($"/helpers?category={category.Id}")" class="text-decoration-none">
                        <div class="card h-100 category-tile">
                            <div class="card-body">
                                <div class="category-tile-name">@category.Name</div>
                                <div class="category-tile-count">@count Helper@(count == 1 ? "" : "s")</div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
}

@code {
    private bool _loading = true;
    private string _displayName = "";
    private int _generalCount;
    private int _myCount;
    private List<(Data.Entities.HelperCategory Category, int Count)> _categories = [];
    private List<Data.Entities.HelperDefinition> _favorites = [];

    protected override async Task OnInitializedAsync()
    {
        _displayName = await CurrentUser.GetDisplayNameAsync();
        var email = await CurrentUser.GetEmailAsync();

        var visibleHelpers = await Db.HelperDefinitions
            .Where(h => h.Scope == HelperScope.General || h.OwnerEmail == email)
            .Select(h => new { h.Scope, h.HelperCategoryId })
            .ToListAsync();

        _generalCount = visibleHelpers.Count(h => h.Scope == HelperScope.General);
        _myCount = visibleHelpers.Count(h => h.Scope == HelperScope.Personal);

        var categories = await Db.HelperCategories.OrderBy(c => c.Name).ToListAsync();
        _categories = categories
            .Select(c => (c, visibleHelpers.Count(h => h.HelperCategoryId == c.Id)))
            .Where(x => x.Item2 > 0)
            .ToList();

        var favoriteIds = await Db.HelperFavorites
            .Where(f => f.UserEmail == email)
            .Select(f => f.HelperDefinitionId)
            .ToListAsync();

        _favorites = await Db.HelperDefinitions
            .Include(h => h.HelperCategory)
            .Where(h => favoriteIds.Contains(h.Id) && (h.Scope == HelperScope.General || h.OwnerEmail == email))
            .OrderBy(h => h.Name)
            .ToListAsync();

        _loading = false;
    }
}
